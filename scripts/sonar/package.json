{
  "name": "librechat-sonar-experiment",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test *.test.mjs",
    "test:coverage": "cd ../.. && mkdir -p .sonar && node --test --experimental-test-coverage --test-coverage-include='scripts/sonar/**/*.mjs' --test-coverage-exclude='**/*.test.mjs' --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=.sonar/lcov.info scripts/sonar/*.test.mjs",
    "scan": "node scan.mjs"
  },
  "dependencies": {
    "@typescript-eslint/parser": "8.71.2",
    "eslint": "9.39.5",
    "eslint-plugin-sonarjs": "4.2.2"
  }
}
